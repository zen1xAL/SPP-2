{
  "name": "spp-lab4-cybertanks-realtime",
  "version": "1.0.0",
  "description": "Multiplayer real-time web game CyberTanks using WebSockets, Vanilla JS Canvas, conflict resolution, offline sync and persistence",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/server.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server",
    "start": "node dist/server/server.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test",
    "tunnel": "npx cloudflared tunnel --url http://localhost:3000",
    "tunnel:dev": ".\\devtunnel.exe host -p 3000 --allow-anonymous"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
