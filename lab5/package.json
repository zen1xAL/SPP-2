{
  "name": "spp-lab5-graphql-federation",
  "version": "1.0.0",
  "description": "High-performance GraphQL Federation platform with 3 automated data sources, 10000+ records, DataLoader, Query Complexity and Tracing",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "vite client",
    "dev": "concurrently -k -n \"SRV,CLI\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build client",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/server.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@apollo/client": "^3.12.8",
    "@apollo/gateway": "^2.9.3",
    "@apollo/server": "^4.11.3",
    "@apollo/subgraph": "^2.9.3",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "graphql": "^16.10.0",
    "graphql-ws": "^5.16.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  }
}

